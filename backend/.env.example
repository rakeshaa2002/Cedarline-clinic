# ---------------------------------------------------------------------------
# Cedarline Clinic API – environment variables
# Copy to backend/.env for local development. Never commit real values.
# ---------------------------------------------------------------------------

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
CLINIC_TIMEZONE=Asia/Kolkata
# Comma-separated browser origins allowed to call the API (your frontend URLs).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL with the pgvector extension. Note the "+psycopg" driver suffix.
# Hosted example (Neon): postgresql+psycopg://user:pass@ep-xxx.region.aws.neon.tech/clinic?sslmode=require
DATABASE_URL=postgresql+psycopg://clinic:change-me@localhost:5434/clinic
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Auth – generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=120

# Accounts created by `python -m app.seed.run` (passwords are hashed with Argon2).
ADMIN_EMAIL=admin@cedarline.example
ADMIN_PASSWORD=choose-a-strong-password
STAFF_EMAIL=staff@cedarline.example
STAFF_PASSWORD=choose-another-strong-password
DOCTOR_EMAIL=doctor@cedarline.example
DOCTOR_PASSWORD=choose-a-doctor-password

# Rate limits (requests per minute per IP)
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_CONTACT_PER_MINUTE=5

# ---------------- AI / RAG ----------------
# Embeddings: gemini | openai | hashing (offline lexical vectors, no API key; dev/demo only)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
# MUST equal the pgvector column size created by the migration (768 by default).
EMBEDDING_DIM=768

# Answer generation: gemini | openai | extractive (quotes retrieved text, no LLM)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# Tried in order if the main model is overloaded (HTTP 429/5xx).
LLM_FALLBACK_MODELS=gemini-flash-lite-latest
LLM_TEMPERATURE=0.2
AI_REQUEST_TIMEOUT_SECONDS=20

GEMINI_API_KEY=
# For any OpenAI-compatible API (OpenAI, Groq, Together, local Ollama via /v1, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
# Leave empty for the provider default (gemini 0.55, openai 0.35, hashing 0.15)
RAG_SIMILARITY_THRESHOLD=
CHAT_MAX_QUESTION_CHARS=500

UPLOAD_MAX_BYTES=5242880
