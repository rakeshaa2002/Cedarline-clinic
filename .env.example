# Used by docker-compose.yml. Copy to .env and fill in the secrets.
# (For running the backend without Docker, use backend/.env.example instead.)

POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=clinic

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

ADMIN_EMAIL=admin@cedarline.example
ADMIN_PASSWORD=choose-a-strong-password
STAFF_EMAIL=staff@cedarline.example
STAFF_PASSWORD=choose-another-strong-password

# Host ports
FRONTEND_PORT=8080
BACKEND_PORT=8000
DB_PORT=5434
CORS_ORIGINS=http://localhost:8080

# AI providers. Without a key, keep hashing + extractive (fully offline, still real pgvector RAG).
# With Gemini: EMBEDDING_PROVIDER=gemini, LLM_PROVIDER=gemini and set GEMINI_API_KEY.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
LLM_PROVIDER=extractive
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODELS=gemini-flash-lite-latest
GEMINI_API_KEY=
OPENAI_API_KEY=
RAG_SIMILARITY_THRESHOLD=
