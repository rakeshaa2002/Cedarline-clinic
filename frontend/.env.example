# Base URL of the FastAPI backend, WITHOUT /api/v1.
# Leave empty in development (Vite proxies /api to http://127.0.0.1:8000).
# Production example: VITE_API_URL=https://cedarline-api.onrender.com
VITE_API_URL=

# Public URL of the website, used for canonical tags, sitemap.xml and robots.txt.
VITE_SITE_URL=http://localhost:5173

# Dev only: where Vite proxies /api (default http://127.0.0.1:8000)
# VITE_DEV_API_PROXY=http://127.0.0.1:8000

# Never put API keys here – anything prefixed VITE_ is shipped to the browser.
